# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.production

# Keep .env.example tracked
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# generated
/src/generated
next-env.d.ts

/src/generated/prisma

# Local Database & Testing Scripts
docker-compose.local-db.yml
reset-tour.ts
test-admin.ts
reset-admin.js

# Build/debug artifacts and one-shot migration scripts (kept on disk, never committed)
.next_dev_log.txt
test-db.js
tsc_output.txt
typescript_errors.log
migrate_roles.js

# Reference documents belong in /public or cloud storage, not the repo root
# (root-anchored: public/templates/*.pdf app assets must stay tracked)
/*.pdf
